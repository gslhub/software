{
  "name": "gslhub-software",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable research software maintained by GSLHub — Generative Search Lab Hub.",
  "license": "AGPL-3.0-only",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.9.0"
